# Android Studio
*.iws
*.ipr
out/

# Gradle wrapper — JAR must be committed so ./gradlew works after clone
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Signing configs and keystores — NEVER commit these
*.jks
*.keystore
keystore.properties
release.properties
release.env
.release.env

# Local configuration files. local.properties (real keystore passwords) stays
# ignored; the committed template below is the only properties file tracked.
local.properties
!local.defaults.properties

# Generated files
app/src/main/assets/

